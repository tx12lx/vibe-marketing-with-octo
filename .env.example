# Copy to .env and fill in values -- never commit .env to version control
# This file covers all environment variables used by the full Vibe OCTO system.

# ---------------------------------------------------------------------------
# Fuel iX (AI model API) -- core/ai_client.py's ask_ai(), used by every agent
# for text generation. Requires reaching api.fuelix.ai (the TELUS corporate
# network, or a Cloud Run service with egress that can reach it -- not the
# old GCE VM, whose network only allowed Google-owned destinations).
#
# FUELIX_MODEL default (claude-sonnet-5) was verified live against Fuel iX's
# real endpoint: current-generation Claude Sonnet, both newer and cheaper
# than claude-sonnet-4/4.5/4.6 (Fuel iX silently serves those older aliases
# as a newer snapshot anyway). Claude 3.5/3.7 Sonnet are listed in Fuel iX's
# model catalog but are NOT actually callable for this org as of the last
# check -- see core/ai_client.py's module docstring before trying one.
# ---------------------------------------------------------------------------
FUELIX_API_KEY=your-fuelix-api-key-here
FUELIX_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# BigQuery -- Application Default Credentials (run: gcloud auth application-default login)
# ---------------------------------------------------------------------------
BQ_PROJECT_ID=bi-srv-hsmdet-pr-7b9def
BQ_DATASET=campaign_data
# The one table the knowledge layer currently syncs schema for (knowledge/sync_schema.py).
# Expanding to more tables is a matter of adding more comma-separated fully-qualified
# names here, not editing code.
BQ_TABLE_NAME=bq_fda_mob_mobility_base

# Alternative one-time fix for the ADC quota-project warning: set this
# stable team project as your quota project instead of a personal one.
#   gcloud auth application-default set-quota-project bi-srv-hsmdet-pr-7b9def
# (needs the "Service Usage Consumer" IAM role on that project -- ask
# whoever administers it if the command reports a permission error).
# Doing this means you never have to run update_personal_project.py again,
# even after your personal project below rotates.

# ---------------------------------------------------------------------------
# Your personal/sandbox GCP project. TELUS expires these on a schedule --
# when yours rotates, update just this one line, then run:
#   python update_personal_project.py
# That sets your ADC quota project to the new project ID.
# ---------------------------------------------------------------------------
PERSONAL_PROJECT_ID=wb-tian-pr-d0dbe6

# ---------------------------------------------------------------------------
# Corporate proxy (required on TELUS corporate network)
# ---------------------------------------------------------------------------
HTTPS_PROXY=http://127.0.0.1:14888
HTTP_PROXY=http://127.0.0.1:14888

# ---------------------------------------------------------------------------
# Web chat shared-password gate (api/web_app.py)
# Only set this when sharing the web chat beyond your own machine (e.g. a
# team pilot). If left blank, the web chat has no password screen at all.
# WEB_APP_SECRET is optional -- if left unset, a random one is generated
# each time the server starts, which just means everyone has to sign back
# in after a restart.
# ---------------------------------------------------------------------------
# WEB_APP_PASSWORD=choose-a-shared-pilot-password
# WEB_APP_SECRET=
