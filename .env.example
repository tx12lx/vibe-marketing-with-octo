# Copy to .env and fill in values -- never commit .env to version control
# This file covers all environment variables used by the full Vibe OCTO system.

# ---------------------------------------------------------------------------
# Fuel iX (AI model API)
# ---------------------------------------------------------------------------
FUELIX_API_KEY=your-fuelix-api-key-here
FUELIX_MODEL=claude-sonnet-4

# ---------------------------------------------------------------------------
# BigQuery -- Application Default Credentials (run: gcloud auth application-default login)
# ---------------------------------------------------------------------------
BQ_PROJECT_ID=bi-srv-hsmdet-pr-7b9def

# ---------------------------------------------------------------------------
# Slack interface (Phase 4 -- active)
# Get these from api.slack.com/apps after creating the Vibe OCTO app:
#   SLACK_BOT_TOKEN      -- Install App page, after installing to workspace
#   SLACK_APP_TOKEN      -- Basic Information > App-Level Tokens (connections:write scope)
#   SLACK_SIGNING_SECRET -- Basic Information > App Credentials > Signing Secret
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Set to false when deploying on an internal server (uses HTTP mode on port 3000)
SLACK_SOCKET_MODE=true
# SLACK_PORT=3000

# ---------------------------------------------------------------------------
# Google Chat interface (Phase 4 -- preserved, activate when GCP permissions resolved)
# Path to the service account credentials JSON file shared by your co-worker.
# ---------------------------------------------------------------------------
# GOOGLE_CHAT_CREDENTIALS=/path/to/service-account-key.json

# ---------------------------------------------------------------------------
# Corporate proxy (required on TELUS corporate network)
# ---------------------------------------------------------------------------
HTTPS_PROXY=http://127.0.0.1:14888
HTTP_PROXY=http://127.0.0.1:14888
