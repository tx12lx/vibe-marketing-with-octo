{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-briefing-output-v1.0",
  "title": "Vibe Briefing Output",
  "description": "Standard JSON contract output by Vibe Briefing for consumption by downstream tools.",
  "type": "object",
  "required": ["brief_metadata", "data_sources", "audience", "offer", "channels", "qc_flags", "execution_readiness", "downstream_tool_inputs"],
  "properties": {
    "brief_metadata": {
      "type": "object",
      "required": ["brief_id", "brief_name", "campaign_objective", "portfolio", "purpose", "cadence", "medium", "created_date", "translation_timestamp", "vibe_briefing_version", "glossary_version"],
      "properties": {
        "brief_id": {"type": "string"},
        "brief_name": {"type": "string"},
        "campaign_objective": {"type": "string", "enum": ["winback", "upsell", "retention", "acquisition", "reactivation"]},
        "portfolio": {"type": "string"},
        "purpose": {"type": "string"},
        "cadence": {"type": "string"},
        "medium": {"type": "array", "items": {"type": "string"}},
        "created_date": {"type": "string"},
        "translation_timestamp": {"type": "string"},
        "vibe_briefing_version": {"type": "string"},
        "glossary_version": {"type": "string"}
      }
    },
    "data_sources": {
      "type": "object",
      "required": ["primary_source"],
      "properties": {
        "primary_source": {
          "type": "object",
          "required": ["database", "project", "dataset", "tables"],
          "properties": {
            "database": {"type": "string"},
            "project": {"type": "string"},
            "dataset": {"type": "string"},
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["table_name", "alias", "description"],
                "properties": {
                  "table_name": {"type": "string"},
                  "alias": {"type": "string"},
                  "description": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "audience": {
      "type": "object",
      "required": ["primary_segment", "exclusions"],
      "properties": {
        "primary_segment": {
          "type": "object",
          "required": ["segment_name", "business_description", "data_rules"],
          "properties": {
            "segment_name": {"type": "string"},
            "business_description": {"type": "string"},
            "data_rules": {
              "type": "object",
              "required": ["filter_logic", "conditions"],
              "properties": {
                "filter_logic": {"type": "string", "enum": ["AND", "OR"]},
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["condition_id", "business_term", "data_source", "operator", "value", "confidence_score", "glossary_matched", "sql_snippet"],
                    "properties": {
                      "condition_id": {"type": "string"},
                      "business_term": {"type": "string"},
                      "data_source": {
                        "type": "object",
                        "required": ["table", "field"],
                        "properties": {
                          "table": {"type": "string"},
                          "field": {"type": "string"}
                        }
                      },
                      "operator": {"type": "string"},
                      "value": {},
                      "confidence_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                      "glossary_matched": {"type": "boolean"},
                      "sql_snippet": {"type": "string"}
                    }
                  }
                }
              }
            },
            "joins": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["join_id", "from_table", "from_field", "to_table", "to_field", "join_type", "sql_snippet"],
                "properties": {
                  "join_id": {"type": "string"},
                  "from_table": {"type": "string"},
                  "from_field": {"type": "string"},
                  "to_table": {"type": "string"},
                  "to_field": {"type": "string"},
                  "join_type": {"type": "string", "enum": ["INNER", "LEFT", "RIGHT", "FULL"]},
                  "sql_snippet": {"type": "string"}
                }
              }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["exclusion_id", "exclusion_name", "business_description", "data_source", "operator", "value", "confidence_score", "sql_snippet"],
            "properties": {
              "exclusion_id": {"type": "string"},
              "exclusion_name": {"type": "string"},
              "business_description": {"type": "string"},
              "data_source": {
                "type": "object",
                "required": ["table", "field"],
                "properties": {
                  "table": {"type": "string"},
                  "field": {"type": "string"}
                }
              },
              "operator": {"type": "string"},
              "value": {},
              "lookback_window_days": {"type": "number"},
              "confidence_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
              "sql_snippet": {"type": "string"}
            }
          }
        },
        "frequency_cap": {
          "type": "object",
          "properties": {
            "max_contacts_per_customer": {"type": "number"},
            "lookback_window_days": {"type": "number"},
            "sql_snippet": {"type": "string"}
          }
        }
      }
    },
    "offer": {
      "type": "object",
      "required": ["offer_id", "offer_name", "business_description", "offer_type"],
      "properties": {
        "offer_id": {"type": "string"},
        "offer_name": {"type": "string"},
        "business_description": {"type": "string"},
        "offer_type": {"type": "string", "enum": ["discount", "bundle", "loyalty", "limited_time", "other"]},
        "eligibility_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "description", "sql_snippet"],
            "properties": {
              "rule_id": {"type": "string"},
              "description": {"type": "string"},
              "sql_snippet": {"type": "string"}
            }
          }
        },
        "known_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conflict_type", "description", "severity"],
            "properties": {
              "conflict_type": {"type": "string"},
              "description": {"type": "string"},
              "severity": {"type": "string", "enum": ["high", "medium", "low"]}
            }
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "required": ["preferred_channels"],
      "properties": {
        "preferred_channels": {"type": "array", "items": {"type": "string"}},
        "channel_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sequence_order", "channel", "timing", "rationale"],
            "properties": {
              "sequence_order": {"type": "number"},
              "channel": {"type": "string"},
              "timing": {
                "type": "object",
                "properties": {
                  "send_on_day": {"type": "number"},
                  "send_time": {"type": "string"},
                  "send_time_zone": {"type": "string"}
                }
              },
              "rationale": {"type": "string"}
            }
          }
        },
        "channel_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "constraint_description", "sql_snippet"],
            "properties": {
              "channel": {"type": "string"},
              "constraint_description": {"type": "string"},
              "sql_snippet": {"type": "string"}
            }
          }
        }
      }
    },
    "qc_flags": {
      "type": "object",
      "properties": {
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flag_id", "field", "issue", "severity", "suggested_clarification"],
            "properties": {
              "flag_id": {"type": "string"},
              "field": {"type": "string"},
              "issue": {"type": "string"},
              "severity": {"type": "string", "enum": ["high", "medium", "low"]},
              "suggested_clarification": {"type": "string"}
            }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description", "fields_involved", "recommended_resolution"],
            "properties": {
              "type": {"type": "string"},
              "description": {"type": "string"},
              "fields_involved": {"type": "array", "items": {"type": "string"}},
              "recommended_resolution": {"type": "string"}
            }
          }
        },
        "low_confidence_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition_id", "confidence_score", "reason"],
            "properties": {
              "condition_id": {"type": "string"},
              "confidence_score": {"type": "number"},
              "reason": {"type": "string"}
            }
          }
        },
        "glossary_misses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["business_term", "closest_match", "action_required"],
            "properties": {
              "business_term": {"type": "string"},
              "closest_match": {"type": "string"},
              "action_required": {"type": "string"}
            }
          }
        }
      }
    },
    "execution_readiness": {
      "type": "object",
      "required": ["completeness_score", "overall_confidence", "qa_passed", "ready_to_execute"],
      "properties": {
        "completeness_score": {"type": "number", "minimum": 0, "maximum": 100},
        "overall_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "qa_passed": {"type": "boolean"},
        "ready_to_execute": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "downstream_tool_inputs": {
      "type": "object",
      "required": ["sizing_tool", "qa_checklist", "frequency_governor", "channel_sequencer", "data_brief_assistant"],
      "properties": {
        "sizing_tool": {
          "type": "object",
          "required": ["status", "instructions"],
          "properties": {
            "status": {"type": "string"},
            "primary_segment_ref": {"type": "string"},
            "exclusions_ref": {"type": "string"},
            "instructions": {"type": "string"}
          }
        },
        "qa_checklist": {
          "type": "object",
          "required": ["status", "instructions"],
          "properties": {
            "status": {"type": "string"},
            "flags_ref": {"type": "string"},
            "instructions": {"type": "string"}
          }
        },
        "frequency_governor": {
          "type": "object",
          "required": ["status", "instructions"],
          "properties": {
            "status": {"type": "string"},
            "frequency_cap_ref": {"type": "string"},
            "instructions": {"type": "string"}
          }
        },
        "channel_sequencer": {
          "type": "object",
          "required": ["status", "instructions"],
          "properties": {
            "status": {"type": "string"},
            "channel_sequence_ref": {"type": "string"},
            "instructions": {"type": "string"}
          }
        },
        "data_brief_assistant": {
          "type": "object",
          "required": ["status", "instructions"],
          "properties": {
            "status": {"type": "string"},
            "instructions": {"type": "string"}
          }
        }
      }
    }
  }
}
