# Copy to .env and fill in values — never commit .env to version control

# BigQuery — Application Default Credentials (gcloud auth application-default login)
BQ_PROJECT=bi-srv-hsmdet-pr-7b9def

# Option B: Service account key file (alternative to ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# BigQuery table (project.dataset.table)
BQ_TABLE=bi-srv-hsmdet-pr-7b9def.campaign_data.bq_plan_camp_deploy_mdc

# Defaults (can be overridden per CLI invocation)
DEFAULT_PORTFOLIO=AAL
DEFAULT_SORT_FIELD=list_pull_date
DEFAULT_TRAIN_LIMIT=200

# Telus Fuel iX — Claude Sonnet 4 via OpenAI-compatible endpoint
FUELIX_API_KEY=your-fuelix-api-key-here
FUELIX_MODEL=claude-sonnet-4

# Corporate proxy (required on corporate network)
HTTPS_PROXY=http://127.0.0.1:14888
HTTP_PROXY=http://127.0.0.1:14888
